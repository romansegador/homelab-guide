# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored: it holds your
# environment's details. It must NEVER hold the API token (export PROXMOX_VE_API_TOKEN instead).

proxmox_endpoint = "https://proxmox.home.example.com:8006/"
proxmox_node     = "pve"
# vm_datastore    = "local-lvm"
# files_datastore = "local"
# network_bridge  = "vmbr0"

hostname = "lab-1"
# vm_id      = 500
# cpu_cores  = 6
# memory_mb  = 16384
# os_disk_gb   = 40
# data_disk_gb = 100

ipv4_cidr     = "192.168.10.50/24"
ipv4_gateway  = "192.168.10.1"
dns_servers   = ["192.168.10.53"]
search_domain = "home.example.com"

admin_user          = "admin"
ssh_public_key_file = "~/.ssh/id_ed25519.pub"
# timezone          = "Europe/Madrid"
